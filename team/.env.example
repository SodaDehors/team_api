# Copying this file is not enough: run python3 team/team.py init to generate secrets.
COMPOSE_PROJECT_NAME=team_api
SUB2API_IMAGE=ghcr.io/wei-shaw/sub2api:0.2.19
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
BIND_HOST=127.0.0.1
SERVER_PORT=8080
TZ=Asia/Shanghai
RUN_MODE=simple
SIMPLE_MODE_AUTO_CREATE_DEFAULT_GROUPS=true
SIMPLE_MODE_KEY_RATE_LIMIT_ENABLED=true
DEFAULT_USER_CONCURRENCY=1
POSTGRES_USER=team_api
POSTGRES_DB=team_api
POSTGRES_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
JWT_SECRET=__GENERATE__
TOTP_ENCRYPTION_KEY=__GENERATE__
ADMIN_EMAIL=__GENERATE__
ADMIN_PASSWORD=__GENERATE__
